## ============================================================================
##  fairfig.mplstyle  -  visual identity for scientific figures (v1.2)
## ----------------------------------------------------------------------------
##  Recommended:   import fairfig as ff; ff.use("acs")      # journal presets, bundled
##                                                          # font, minor grid, colormaps
##  Style only:    plt.style.use(r"<path>/fairfig/fairfig.mplstyle")
##
##  Base values = ACS single column (84.6 mm wide), 8 pt Liberation Mono.
##  Colours: Okabe-Ito hues, fixed order (blue, vermillion, bluish green, orange,
##  sky blue, reddish purple); blue and vermillion darkened so slots 1-3 differ
##  in brightness.  Never rainbow/jet.  Never colour alone: pair every colour
##  with a marker shape or line style.  Okabe-Ito in its published order
##  instead: ff.use(palette="okabe-ito").
## ============================================================================

## ---- Figure & export -------------------------------------------------------
figure.figsize                   : 3.333, 2.667   # 84.6 mm x 67.7 mm
figure.dpi                       : 150            # screen preview only
figure.facecolor                 : white
figure.constrained_layout.use    : True
figure.constrained_layout.h_pad  : 0.02
figure.constrained_layout.w_pad  : 0.02
figure.constrained_layout.hspace : 0.03
figure.constrained_layout.wspace : 0.03
savefig.format                   : svg            # ff.save writes SVG + PDF
savefig.dpi                      : 600            # only used if you export png/tiff
savefig.bbox                     : standard       # keep the exact journal width
savefig.pad_inches               : 0.02
savefig.facecolor                : white
savefig.transparent              : False
svg.fonttype                     : none           # text stays text in SVG
pdf.fonttype                     : 42             # embedded TrueType, editable text
ps.fonttype                      : 42

## ---- Typography: Liberation Mono, one size ----------------------------------
font.family            : monospace
font.monospace         : Liberation Mono, Courier New, Courier, Nimbus Mono PS, FreeMono, DejaVu Sans Mono
font.size              : 8
axes.labelsize         : 8
axes.titlesize         : 8
axes.titleweight       : bold
xtick.labelsize        : 8
ytick.labelsize        : 8
legend.fontsize        : 8
legend.title_fontsize  : 8
figure.titlesize       : 8
figure.labelsize       : 8
mathtext.fontset       : custom           # math in the same face: italic T, x, p; upright units
mathtext.rm            : Liberation Mono
mathtext.it            : Liberation Mono:italic
mathtext.bf            : Liberation Mono:bold
mathtext.sf            : Liberation Mono
mathtext.tt            : Liberation Mono
mathtext.cal           : Liberation Mono
mathtext.fallback      : stix
axes.unicode_minus     : True             # true minus sign (U+2212)
axes.formatter.use_mathtext : True
axes.formatter.limits  : -3, 4
text.color             : black

## ---- Axes & ticks: closed box, outward ticks (left/bottom), faint grid -------
axes.linewidth     : 0.6
axes.edgecolor     : black
axes.labelcolor    : black
axes.labelpad      : 3.0
axes.titlepad      : 4.0
axes.spines.top    : True
axes.spines.right  : True
axes.grid          : True
axes.grid.which    : major                # ff.figure()/ff.subplots() add a lighter minor grid
axes.axisbelow     : True
grid.color         : E6E6E6
grid.linewidth     : 0.5                  # ACS minimum line weight
grid.linestyle     : -
grid.alpha         : 1.0
axes.xmargin       : 0.03
axes.ymargin       : 0.05
axes.prop_cycle    : cycler('color', ['005B90', 'BB4000', '009E73', 'E69F00', '56B4E9', 'CC79A7'])
xtick.direction    : out
ytick.direction    : out
xtick.top          : False
ytick.right        : False
xtick.major.size   : 3.0
ytick.major.size   : 3.0
xtick.minor.size   : 1.6
ytick.minor.size   : 1.6
xtick.major.width  : 0.6
ytick.major.width  : 0.6
xtick.minor.width  : 0.5
ytick.minor.width  : 0.5
xtick.major.pad    : 2.5
ytick.major.pad    : 2.5
xtick.minor.visible: True
ytick.minor.visible: True
xtick.color        : black
ytick.color        : black

## ---- Lines, markers, patches ------------------------------------------------
lines.linewidth        : 1.0
lines.markersize       : 4.0
lines.markeredgewidth  : 0.6
lines.solid_capstyle   : round
lines.solid_joinstyle  : round
lines.dash_capstyle    : butt
lines.scale_dashes     : True
patch.linewidth        : 0.6
hatch.linewidth        : 0.5
errorbar.capsize       : 1.5
image.cmap             : cividis          # ff.use() switches this to batlow

## ---- Legend: frameless, black text (ff.legend puts it above the plot) --------
legend.frameon         : False
legend.loc             : best
legend.numpoints       : 1
legend.scatterpoints   : 1
legend.handlelength    : 1.8
legend.handleheight    : 0.7
legend.handletextpad   : 0.5
legend.labelspacing    : 0.35
legend.columnspacing   : 1.2
legend.borderaxespad   : 0.5
legend.borderpad       : 0.3
